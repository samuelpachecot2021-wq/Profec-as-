# ─────────────────────────────────────────────────────────────
# PROFECÍA STUDIO AI — Claves opcionales
# Copia este archivo como ".env.local" y rellena SOLO las que tengas.
# También puedes configurarlas desde la app: menú «Ajustes».
# NUNCA subas .env.local a GitHub (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────

# Guion inteligente y traducción (de pago, muy barato por video)
ANTHROPIC_API_KEY=
# Modelo de Claude (por defecto: claude-opus-5-5)
ANTHROPIC_MODEL=

# Alternativa GRATUITA y local: Ollama (https://ollama.com)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Voces
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Bancos de imágenes y videos (gratuitos con registro)
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# Imágenes generadas con IA (de pago)
OPENAI_API_KEY=

# ── Acceso privado (OBLIGATORIO en un servidor de internet) ──
ADMIN_USER=admin
ADMIN_PASSWORD=
# Videos que se producen a la vez (por defecto, según la CPU y la memoria reales del servidor)
MAX_CONCURRENT_JOBS=
# Hilos por proceso de FFmpeg (por defecto 2 con poca memoria, 4 con más)
FFMPEG_THREADS=
# Memoria del servidor en MB, si el proveedor no la informa (p. ej. 2048)
RENDER_MEMORY_MB=

# Voz Azure con el plan gratuito F0 (si/no): si es "si", no se cuentan costos
AZURE_FREE_TIER=no
